{
  "rule_files": [
    "rules.json"
  ],
  "evaluation_interval": "1m",
  "tests": [
    {
      "name": "target outage and recovery",
      "interval": "1m",
      "input_series": [
        {
          "series": "up{job=\"status-board\",instance=\"status-board:8000\"}",
          "values": "1 0 0 0 1 1 1"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "3m",
          "alertname": "StatusBoardDown",
          "exp_alerts": [
            {
              "exp_labels": {
                "job": "status-board",
                "instance": "status-board:8000",
                "severity": "critical"
              },
              "exp_annotations": {
                "summary": "Status Board metrics target is unavailable.",
                "description": "Check the application process, Service endpoints and collector connectivity."
              }
            }
          ]
        },
        {
          "eval_time": "5m",
          "alertname": "StatusBoardDown",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "missing target is detected",
      "interval": "1m",
      "input_series": [],
      "alert_rule_test": [
        {
          "eval_time": "3m",
          "alertname": "StatusBoardDown",
          "exp_alerts": [
            {
              "exp_labels": {
                "job": "status-board",
                "severity": "critical"
              },
              "exp_annotations": {
                "summary": "Status Board metrics target is unavailable.",
                "description": "Check the application process, Service endpoints and collector connectivity."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "token readiness failure",
      "interval": "1m",
      "input_series": [
        {
          "series": "status_board_ready{job=\"status-board\",instance=\"status-board:8000\"}",
          "values": "0+0x5"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "3m",
          "alertname": "StatusBoardNotReady",
          "exp_alerts": [
            {
              "exp_labels": {
                "job": "status-board",
                "instance": "status-board:8000",
                "severity": "critical"
              },
              "exp_annotations": {
                "summary": "Status Board cannot read a valid API token.",
                "description": "Check the mounted secret, CSI provider and Workload Identity. Do not print the token."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "sustained server errors",
      "interval": "1m",
      "input_series": [
        {
          "series": "status_board_http_requests_total{job=\"status-board\",route=\"/api/status\",status=\"200\"}",
          "values": "0+60x15"
        },
        {
          "series": "status_board_http_requests_total{job=\"status-board\",route=\"/api/status\",status=\"500\"}",
          "values": "0+10x15"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "12m",
          "alertname": "StatusBoardHighErrorRate",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "warning"
              },
              "exp_annotations": {
                "summary": "More than 5% of application requests fail.",
                "description": "At least 20 requests in 5 minutes are required. Inspect request logs by route and status."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "low traffic must not page",
      "interval": "1m",
      "input_series": [
        {
          "series": "status_board_http_requests_total{job=\"status-board\",route=\"/api/status\",status=\"200\"}",
          "values": "0+1x15"
        },
        {
          "series": "status_board_http_requests_total{job=\"status-board\",route=\"/api/status\",status=\"500\"}",
          "values": "0+1x15"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "12m",
          "alertname": "StatusBoardHighErrorRate",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "healthy traffic",
      "interval": "1m",
      "input_series": [
        {
          "series": "status_board_http_requests_total{job=\"status-board\",route=\"/api/status\",status=\"200\"}",
          "values": "0+60x15"
        },
        {
          "series": "status_board_http_requests_total{job=\"status-board\",route=\"/api/status\",status=\"500\"}",
          "values": "0+0x15"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "12m",
          "alertname": "StatusBoardHighErrorRate",
          "exp_alerts": []
        }
      ]
    },
    {
      "name": "slow requests trigger latency",
      "interval": "1m",
      "input_series": [
        {
          "series": "status_board_http_request_duration_seconds_bucket{job=\"status-board\",route=\"/api/status\",le=\"0.5\"}",
          "values": "0+0x15"
        },
        {
          "series": "status_board_http_request_duration_seconds_bucket{job=\"status-board\",route=\"/api/status\",le=\"1.0\"}",
          "values": "0+60x15"
        },
        {
          "series": "status_board_http_request_duration_seconds_bucket{job=\"status-board\",route=\"/api/status\",le=\"+Inf\"}",
          "values": "0+60x15"
        },
        {
          "series": "status_board_http_requests_total{job=\"status-board\",route=\"/api/status\",status=\"200\"}",
          "values": "0+60x15"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "12m",
          "alertname": "StatusBoardHighLatency",
          "exp_alerts": [
            {
              "exp_labels": {
                "severity": "warning"
              },
              "exp_annotations": {
                "summary": "Status Board p95 request duration exceeds 500 ms.",
                "description": "Check application resource pressure and slow routes. Low-traffic windows do not trigger this alert."
              }
            }
          ]
        }
      ]
    },
    {
      "name": "fast requests remain healthy",
      "interval": "1m",
      "input_series": [
        {
          "series": "status_board_http_request_duration_seconds_bucket{job=\"status-board\",route=\"/api/status\",le=\"0.5\"}",
          "values": "0+60x15"
        },
        {
          "series": "status_board_http_request_duration_seconds_bucket{job=\"status-board\",route=\"/api/status\",le=\"1.0\"}",
          "values": "0+60x15"
        },
        {
          "series": "status_board_http_request_duration_seconds_bucket{job=\"status-board\",route=\"/api/status\",le=\"+Inf\"}",
          "values": "0+60x15"
        },
        {
          "series": "status_board_http_requests_total{job=\"status-board\",route=\"/api/status\",status=\"200\"}",
          "values": "0+60x15"
        }
      ],
      "alert_rule_test": [
        {
          "eval_time": "12m",
          "alertname": "StatusBoardHighLatency",
          "exp_alerts": []
        }
      ]
    }
  ]
}
